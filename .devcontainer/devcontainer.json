{
	"name": "notification-utils",
	"build": {
		"dockerfile": "Dockerfile",
		"context": ".."
	},
	"features": {
		// Node.js (npx) is needed by `make email-samples` for the email client compatibility check
		"ghcr.io/devcontainers/features/node:1": {
			"version": "lts"
		}
	},
	"remoteEnv": {
		"PATH": "/home/vscode/.local/bin:${containerEnv:PATH}" // give our installed Python modules precedence
	},
	"containerEnv": {
		"SHELL": "/bin/zsh"
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"donjayamanne.python-extension-pack",
				"ms-python.python",
				"ms-python.vscode-pylance",
				"eamodio.gitlens",
				"GitHub.copilot",
				"tamasfe.even-better-toml",
				"charliermarsh.ruff",
			],
			"settings": {
				"python.defaultInterpreterPath": "/home/vscode/.venv/workspace/bin/python",
				"python.venvPath": "/home/vscode/.venv",
				"ruff.lint.ignore": ["F401"],
				"ruff.lint.run": "onSave",
				"ruff.organizeImports": false,
				"[python]": {
					"editor.defaultFormatter": "charliermarsh.ruff"
				}
			}
		}
	},
	"postCreateCommand": "notify-dev-entrypoint.sh",
}